LLM_ENABLED=true
LLM_API_KEY=""
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=512
LLM_TEMPERATURE=0
LLM_BUDGET_USD=
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Local Ollama development only (start/configure Ollama separately):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<installed local model name>
# LLM_API_KEY=<local placeholder if authentication is not required>
# Remote organizer/provider: keep disabled until supplied values are available.
# LLM_BASE_URL=https://<provider host>/<API base path>
# LLM_MODEL=<provider-supplied model>
# LLM_API_KEY=<provider-supplied secret; never commit>
# Set pricing/budget only from authoritative provider information.
